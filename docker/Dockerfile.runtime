ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/runtime

COPY requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt \
    && mkdir -p /app/data /data/worldcover \
    && chown -R 10001:10001 /app /data

ENV SAT_WORLDCOVER_DIR=/data/worldcover \
    SAT_WORLDCOVER_MANIFEST_PATH=/app/data/worldcover_manifest.json

COPY --chown=10001:10001 app /app/app
COPY --chown=10001:10001 data/worldcover_manifest.json /app/data/worldcover_manifest.json
COPY --chown=10001:10001 docker/start.sh /usr/local/bin/start-fire-satellite
RUN chmod +x /usr/local/bin/start-fire-satellite

WORKDIR /app
USER 10001:10001
VOLUME ["/data/worldcover"]
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health/ready', timeout=3).read()" || exit 1

ENTRYPOINT ["/usr/local/bin/start-fire-satellite"]
